# Copy to .env. Every value here has a working default except the ones marked required.

# Where the SQLite database and backups live. Mount this as a volume.
ZEROFOLD_DATA_DIR=./data

# Public origin, used for absolute links and cookie scoping.
ZEROFOLD_BASE_URL=http://localhost:3000

# Session signing secret. Generated and persisted into ZEROFOLD_DATA_DIR on first run if unset.
# ZEROFOLD_SECRET=

# error | warn | info | debug
ZEROFOLD_LOG_LEVEL=info

# Invite-only by default. The first account created on an empty instance becomes the admin.
ZEROFOLD_ALLOW_OPEN_REGISTRATION=false
